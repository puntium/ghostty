# --- scrolling distance (N2): wheel 3 lines/notch, touchpad as Electron -------
# Electron (Chromium on Wayland, xterm.js): a touchpad pixel is 12 CSS px,
# a row is 17 CSS px, so 4 x 20 px = 960 px = 56 lines (rounded). Normal
# screen, alternate screen (arrow keys) and mouse reporting (wheel reports).
# One distance sliced three ways must give the same result (xterm keeps
# the fraction: final check, slicing): 85 px = 1020 CSS px = 60 rows.
slice_cmds() { # N: 85 px up in 1 px, 5 px, or 7 px (+1) events
  local c="" n step
  case "$1" in 0) step=1 ;; 1) step=5 ;; 2) step=7 ;; esac
  for ((n = 0; n + step <= 85; n += step)); do c+=", fscroll 0 -$step"; done
  (( n < 85 )) && c+=", fscroll 0 -$((85 - n))"
  echo "$c, fstop"
}
scroll_counts() { # SCALE-LABEL: checks on the current run
  fresh 'seq 1 400\n'; wait_ $'\n400\n' || fail "seq 400"
  read -r x y < <(pt 20 10)
  local o0 o1 o2 k got
  o0=$(field panes.0.scrollbar.offset)
  rp abs "$x" "$y", sleep 50, scroll 0 -1; sleep 0.3; o1=$(field panes.0.scrollbar.offset)
  rp abs "$x" "$y", sleep 50, fscroll 0 -20, sleep 16, fscroll 0 -20, sleep 16, fscroll 0 -20, sleep 16, fscroll 0 -20, sleep 16, fstop; sleep 0.3
  o2=$(field panes.0.scrollbar.offset)
  (( o0 - o1 == 3 )) || fail "$1: a wheel notch scrolled $((o0 - o1)) lines, want 3"
  (( o1 - o2 == 56 )) || fail "$1: an 80 px touchpad scroll moved $((o1 - o2)) lines, want 56"
  got=""
  for k in 0 1 2; do
    fresh 'seq 1 400\n'; wait_ $'\n400\n' || fail "seq 400"
    o0=$(field panes.0.scrollbar.offset)
    rp abs "$x" "$y$(slice_cmds $k)"; sleep 0.3
    got="$got $((o0 - $(field panes.0.scrollbar.offset)))"
  done
  [[ "$got" == " 60 60 60" ]] || fail "$1: 85 px sliced in 1/5/7 px events moved [$got ] lines, want 60 each"
  cp "$here/raw-reader.py" "$dir/host/home/raw-reader.py"
  local mode
  for mode in alt mouse; do
    rm -f "$dir/host/home/raw.out"
    fresh "python3 ~/raw-reader.py $mode ~/raw.out\n"; wait_ RAW-READY || fail "raw reader"
    rp abs "$x" "$y", sleep 50, scroll 0 -1, sleep 100$(slice_cmds 0 | sed 's/, fstop$//'), fstop, sleep 100$(slice_cmds 1), sleep 100$(slice_cmds 2)
    for _ in $(seq 1 80); do [[ -s "$dir/host/home/raw.out" ]] && break; sleep 0.1; done
    local n
    n=$(python3 -I -c 'import sys,re; b=eval(open(sys.argv[1]).read()); print(b.count(b"\x1b[A")+b.count(b"\x1bOA") if sys.argv[2]=="alt" else len(re.findall(rb"\x1b\[<64;", b)))' "$dir/host/home/raw.out" "$mode")
    (( n == 183 )) || fail "$1 $mode screen: a notch + 3 x 85 px (sliced 1/5/7 px) gave $n up events, want 3 + 3 x 60"
  done
  ok "$1: wheel 3 lines/notch; touchpad 80 px = 56 lines; 85 px = 60 lines however it is sliced, on the normal screen, as arrow keys (alt screen) and as wheel reports"
}
