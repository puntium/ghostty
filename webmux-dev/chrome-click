#!/usr/bin/env bash
# Real pointer clicks on the chrome's widgets by name (webmux-dev/realpointer
# through the compositor; positions from the `chrome-bounds` control
# command plus the window's place in sway's tree).
#
#   webmux-dev/chrome-click DIR NAME              click the middle of NAME
#   webmux-dev/chrome-click DIR NAME --dx N       … N px right of the middle
#   webmux-dev/chrome-click DIR --at X Y          click window coords X,Y
#   webmux-dev/chrome-click DIR --drag NAME DX    press on NAME, move DX px
#                                                 in steps, release
#   webmux-dev/chrome-click DIR --hover NAME      move there, no click
#   webmux-dev/chrome-click DIR --where NAME      print the screen point
#
# Names: `wmctl chrome-bounds` (header.*, pill.<name>, pill.<name>.x,
# card.<name>.<label>, card.<name>.menu, card.<name>.restart|delete,
# form.*, page.*).
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
dir="${1:?usage: chrome-click DIR NAME}"; shift

origin() {
  "$here/in-session" "$dir" swaymsg -t get_tree | python3 -I -c '
import json, sys
def walk(n):
    if n.get("app_id") == "me.puntium.webmux.gtk":
        r = n["rect"]; print(r["x"], r["y"]); sys.exit(0)
    for c in n.get("nodes", []) + n.get("floating_nodes", []): walk(c)
walk(json.load(sys.stdin)); sys.exit(1)'
}

point() { # NAME [DX] -> screen X Y of the widget's middle
  local name="$1" dx="${2:-0}"
  read -r ox oy < <(origin)
  "$here/wmctl" -s "$dir/ctl.sock" chrome-bounds | python3 -I -c '
import json, sys
name, dx, ox, oy = sys.argv[1], float(sys.argv[2]), int(sys.argv[3]), int(sys.argv[4])
for b in json.load(sys.stdin)["result"]:
    if b["name"] == name:
        if not b["visible"]: sys.exit("chrome-click: %s is not visible" % name)
        print(int(ox + b["x"] + b["w"] / 2 + dx), int(oy + b["y"] + b["h"] / 2)); sys.exit(0)
sys.exit("chrome-click: no widget %s" % name)' "$name" "$dx" "$ox" "$oy"
}

case "${1:-}" in
  --at)
    read -r ox oy < <(origin)
    "$here/realpointer" "$dir" "abs $((ox + $2)) $((oy + $3)), sleep 60, down, sleep 60, up, sleep 60" ;;
  --drag)
    read -r x y < <(point "$2")
    dx="$3"; steps=8; cmds="abs $x $y, sleep 80, down, sleep 80"
    for i in $(seq 1 $steps); do cmds+=", abs $((x + dx * i / steps)) $y, sleep 40"; done
    cmds+=", sleep 80, up, sleep 80"
    "$here/realpointer" "$dir" "$cmds" ;;
  --hover)
    read -r x y < <(point "$2")
    "$here/realpointer" "$dir" "abs $x $y, sleep 120" ;;
  --where)
    point "$2" ;;
  *)
    dx=0
    [[ "${2:-}" == "--dx" ]] && dx="$3"
    read -r x y < <(point "$1" "$dx")
    "$here/realpointer" "$dir" "abs $x $y, sleep 60, down, sleep 60, up, sleep 60" ;;
esac
