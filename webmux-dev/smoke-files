import json, sys
d = json.load(sys.stdin)["result"]; c = [x for x in d["columns"] if x["key"].endswith("/uploads")][0]
print(int(c["x"] + c["target_width"] / 2) + int(sys.argv[1]) + 7, int(sys.argv[2]) + 300)' "$wx" "$wy")
  n_up="$(grep -c "status: uploaded 2 file(s) → $H/uploads" "$dir/app.log" || true)"
