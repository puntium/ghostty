  printf '%s\n' up "sleep 400" >&7; exec 7>&-
  expect "$hl" "True" "F-54: no drop highlight under a real drag"
  for _ in $(seq 1 50); do (( $(grep -c "status: uploaded 2 file(s) → $H/uploads" "$dir/app.log" || true) > n_up )) && break; sleep 0.1; done
  (( $(grep -c "status: uploaded 2 file(s) → $H/uploads" "$dir/app.log" || true) > n_up )) || fail "F-54: real drag-and-drop did not upload"
