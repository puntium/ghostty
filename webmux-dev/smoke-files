printf '[TOPLINKTOPLINKTOPLINK](#top)\n\n' > "$H/wide/file-1500.md"
cat "$H/README.md" >> "$H/wide/file-1500.md"; seq 300 | sed 's/^/line /' >> "$H/wide/file-1500.md"
sleep 1; idle focus-setup
