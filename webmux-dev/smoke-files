import json, sys
def walk(n):
    if n.get("app_id") == "dragon-drop": print(n["rect"]["x"] + 30, n["rect"]["y"] + n["rect"]["height"] // 2); sys.exit(0)
    for k in n.get("nodes", []) + n.get("floating_nodes", []): walk(k)
walk(json.load(sys.stdin)); print("")') || true
    [[ -n "${gx:-}" ]] && break; sleep 0.1
