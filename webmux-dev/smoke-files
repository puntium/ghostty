open_ "$H/stress/s1" "s1-a-rather-long-file-name-1000.txt"
worst=10000
cat > "$dir/stall-probe.py" <<'EOF'
import socket, sys, time
s = socket.socket(socket.AF_UNIX); s.connect(sys.argv[1]); f = s.makefile("rb")
end = time.time() + 1.2; last = time.time(); w = 0
while time.time() < end:
    s.sendall(b'{"cmd":"files-state","entries":false}\n'); f.readline()
    now = time.time(); w = max(w, now - last); last = now
print(int(w * 1000))
EOF
for t in 1 2 3; do
  sleep 4.3
  python3 -I "$dir/stall-probe.py" "$dir/ctl.sock" > "$dir/stall.out" &
  sleep 0.2; "$here/realkeys" "$dir" j; wait
  g="$(cat "$dir/stall.out")"
  (( g < worst )) && worst=$g
done
(( worst < 200 )) || fail "D8: main loop stalled ${worst} ms on a key press after the cache expired"
echo "smoke-files: D8 best-of-3 worst gap ${worst} ms"
# D8, first display: a fresh 2000-row directory is built a screenful at a
