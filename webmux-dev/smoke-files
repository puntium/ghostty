[[ "$(st focused)" == true ]] || fail "focus test: the browser has no focus"
open_ "$H/wide" "file-1500.md"
read -r lx0 ly0 < <(at link:#top 30)
rp abs $((lx0 - 10)) "$ly0", sleep 40, abs $((lx0 - 5)) "$ly0", sleep 40, abs "$lx0" "$ly0", sleep 200, down, sleep 40, up, sleep 300
read -r bx by < <(at preview-body)
rp abs $((bx - 3)) "$by", sleep 30, abs "$bx" "$by", sleep 30, scroll 0 3, sleep 300
view() { ctl files-state entries:=false | python3 -I -c '
import json, sys
d = json.load(sys.stdin)["result"]
print(round(d["hscroll"]["value"]), d["hscroll"]["pinned"], [round(c["scroll_y"] or 0) for c in d["columns"] if c["kind"] == "listing"],
      [round(c["preview"]["scroll_y"] or 0) for c in d["columns"] if c["kind"] == "preview"])'; }
