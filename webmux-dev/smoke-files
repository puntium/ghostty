fi
[[ "$(st focused)" == true ]] || "$here/realkeys-xkb" "$dir" ctrl+shift+h >/dev/null
ctl -q pane-command name=focus-right; ctl -q pane-command name=close-pane
ctl -q workspace-wait panes:=1 timeout_ms:=15000 || fail "terminal pane not closed"
