same() { local v; sleep 0.6; v="$(view)"; [[ "$v" == "$v0" ]] || fail "view changed $1: $v0 → $v"; }
back() { "$here/realkeys-xkb" "$dir" "$1" >/dev/null; sleep 0.6; [[ "$(st focused)" == true ]] || fail "focus did not come back ($2)"; same "after focus came back ($2)"; }
"$here/realkeys-xkb" "$dir" ctrl+shift+l >/dev/null; same "on a chord to the terminal"
back ctrl+shift+h "chord"
read -r tx ty < <(ctl workspace | python3 -I -c '
import json, sys
d = json.load(sys.stdin)["result"]; s = d["scroll"]
p = [p for c in d["columns"] for p in c["panes"] if p["kind"] == "terminal"][0]["box"]
x = min(max(p["x"] - s + 40, 5), 1390)
print(int(x) + int(sys.argv[1]), p["y"] + 200 + int(sys.argv[2]))' "$wx" "$wy")
rp abs $((tx - 3)) "$ty", sleep 30, abs "$tx" "$ty", sleep 30, down, sleep 40, up, sleep 200
[[ "$(st focused)" == false ]] || fail "a click on the terminal did not take focus"
same "on a click on the terminal"
back ctrl+shift+h "click"
"$here/realkeys-xkb" "$dir" ctrl+comma >/dev/null; sleep 0.8; same "when the settings opened"
